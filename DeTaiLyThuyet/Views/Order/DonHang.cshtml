@model IEnumerable<DeTaiLyThuyet.Models.DonHang>
@using System.Linq

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đơn hàng - Gift Shop</title>
    <link href="~/Content/css/style.css" rel="stylesheet" />
</head>
<body>
    <div id="header"></div>

    <div class="vung">
        <h2 class="tieude">Đơn hàng của tôi</h2>

        <div id="ds">
            @if (Model == null || !Model.Any())
            {
                <p>Bạn chưa có đơn hàng nào.</p>
            }
            else
            {
                foreach (var d in Model)
                {
                    <div class="donhang">
                        <h3>Đơn @d.MaDonHang</h3>

                        <p>
                            Ngày đặt: @d.NgayDat.ToString("dd/MM/yyyy HH:mm")
                            <br />
                            Người nhận: @d.TenNguoiNhan - @d.SoDienThoai
                            <br />
                            Địa chỉ: @d.DiaChiGiaoHang
                            <br />
                            Thanh toán: @d.PhuongThucThanhToan
                            <br />
                            Trạng thái: @d.TrangThai
                        </p>

                        <table class="bang">
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                            </tr>

                            @foreach (var ct in d.DonHangChiTiets)
                            {
                                <tr>
                                    <td>@ct.TenSanPham</td>
                                    <td>@ct.DonGia.ToString("N0") đ</td>
                                    <td>@ct.SoLuong</td>
                                </tr>
                            }
                        </table>

                        <div class="tong">
                            Tổng: @d.TongTien.ToString("N0") đ
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <div id="footer"></div>

    <script src="~/Scripts/js/main.js"></script>
</body>
</html>