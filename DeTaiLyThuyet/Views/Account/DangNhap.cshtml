@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Gift Shop</title>
    <link href="~/Content/css/style.css" rel="stylesheet" />
</head>
<body>
    <div id="header"></div>

    <div class="vung">
        <div class="hop" id="formDangNhap">
            @Html.AntiForgeryToken()
            <h2>Đăng nhập</h2>
            <label>Email</label>
            <input type="text" id="dnEmail" />
            <label>Mật khẩu</label>
            <input type="password" id="dnMatKhau" />
            <button class="nut" onclick="xuLyDangNhap()">Đăng nhập</button>
            <p>Chưa có tài khoản? <a href="#" onclick="chuyenForm(false);return false;"><b>Đăng ký</b></a></p>
        </div>

        <div class="hop" id="formDangKy" style="display:none;">
            @Html.AntiForgeryToken()
            <h2>Đăng ký</h2>
            <label>Họ tên</label>
            <input type="text" id="dkTen" />
            <label>Email</label>
            <input type="text" id="dkEmail" />
            <label>Mật khẩu</label>
            <input type="password" id="dkMatKhau" />
            <label>Nhập lại mật khẩu</label>
            <input type="password" id="dkNhapLai" />
            <button class="nut" onclick="xuLyDangKy()">Đăng ký</button>
            <p>Đã có tài khoản? <a href="#" onclick="chuyenForm(true);return false;"><b>Đăng nhập</b></a></p>
        </div>
    </div>

    <div id="footer"></div>

    <script src="~/Scripts/js/main.js"></script>
    <script>
        function chuyenForm(hienDangNhap) {
            document.getElementById("formDangNhap").style.display = hienDangNhap ? "block" : "none";
            document.getElementById("formDangKy").style.display = hienDangNhap ? "none" : "block";
        }

        async function xuLyDangKy() {
    var hoTen = document.getElementById("dkTen").value.trim();
    var email = document.getElementById("dkEmail").value.trim().toLowerCase();
    var matKhau = document.getElementById("dkMatKhau").value;
    var nhapLai = document.getElementById("dkNhapLai").value;

    if (!hoTen || !email || !matKhau) {
        alert("Vui lòng nhập đầy đủ thông tin");
        return;
    }

    if (matKhau !== nhapLai) {
        alert("Mật khẩu nhập lại không khớp");
        return;
    }

    var token = document.querySelector(
        '#formDangKy input[name="__RequestVerificationToken"]'
    ).value;

    try {
        var response = await fetch('@Url.Action("DangKy", "Account")', {
            method: "POST",
            headers: {
                "Content-Type": "application/x-www-form-urlencoded"
            },
            body: new URLSearchParams({
                hoTen: hoTen,
                email: email,
                matKhau: matKhau,
                __RequestVerificationToken: token
            })
        });

        if (!response.ok) {
            alert("Không thể đăng ký. Mã lỗi: " + response.status);
            return;
        }

        var result = await response.json();

        alert(result.message);

        if (result.success) {
            chuyenForm(true);
        }
    } catch (error) {
        alert("Không thể kết nối đến máy chủ.");
        console.error(error);
    }
}

        async function xuLyDangNhap() {
    var email = document.getElementById("dnEmail").value.trim();
    var matKhau = document.getElementById("dnMatKhau").value;

    if (!email || !matKhau) {
        alert("Vui lòng nhập email và mật khẩu.");
        return;
    }

    var token = document.querySelector(
        '#formDangNhap input[name="__RequestVerificationToken"]'
    ).value;

    try {
        var response = await fetch('@Url.Action("XuLyDangNhap", "Account")', {
            method: "POST",
            headers: {
                "Content-Type": "application/x-www-form-urlencoded"
            },
            body: new URLSearchParams({
                email: email,
                matKhau: matKhau,
                __RequestVerificationToken: token
            })
        });

        if (!response.ok) {
            alert("Đăng nhập thất bại. Mã lỗi: " + response.status);
            return;
        }

        var result = await response.json();

        alert(result.message);

        if (result.success) {
            window.location.href = result.redirectUrl;
        }
    } catch (error) {
        alert("Không thể kết nối đến máy chủ.");
        console.error(error);
    }
}
    </script>
</body>
</html>